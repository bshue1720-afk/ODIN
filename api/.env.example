# ═══════════════════════════════════════════════
# ODIN — Environment Variables (Railway)
# Copy this to .env for local dev.
# In Railway: set these as environment variables.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════

# PostgreSQL — Railway auto-provides this on deploy
DATABASE_URL=postgresql://user:password@host:5432/railway

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret

# App
FLASK_ENV=production
PORT=8000

# Slack — set these to enable notifications
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_BROCK=#odin-brock
SLACK_CHANNEL_PARTNER=#odin-partner
SLACK_CHANNEL_AM=#odin-am
SLACK_CHANNEL_DISPO=#odin-dispo
SLACK_CHANNEL_WIFE=#odin-wife

# Rentcast — already in tools/rentcast_key.txt for the Deal Analyzer
RENTCAST_API_KEY=your-rentcast-key
